# PUBLIC INTERFACE: Frontend environment variables
# SITE URL used for auth redirects (if backend requires emailRedirectTo etc.)
REACT_APP_SITE_URL=http://localhost:3000

# API Gateway base URL for the SPA to call backend services through the gateway
REACT_APP_API_GATEWAY_URL=http://localhost:8080

# WebSocket URL for real-time notifications (typically served by the Gateway)
# Example: ws://localhost:8080/ws/notifications
REACT_APP_WS_URL=ws://localhost:8080/ws/notifications
